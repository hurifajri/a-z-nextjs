{
  "name": "slides",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "slidev build",
    "dev": "slidev --open",
    "export": "slidev export",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@slidev/cli": "^52.19.1",
    "vue": "^3.5.33"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-slidev": "^1.0.5"
  },
  "slidev": {
    "colorSchema": "light",
    "defaults": {
      "fonts": {
        "sans": "Space Grotesk, Plus Jakarta Sans, sans-serif",
        "mono": "Space Mono, Fira Code, monospace"
      }
    }
  }
}
